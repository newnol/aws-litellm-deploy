# ============================================================
# Copy this file to terraform.tfvars and customize
# ============================================================

project_name = "litellm"
environment  = "prod"
aws_region   = "ap-southeast-1"

# VPC
vpc_cidr           = "10.0.0.0/16"
enable_nat_gateway = true   # ~$32/month, set false to save

# ECS Fargate
container_port  = 4000
task_cpu        = 512      # 0.5 vCPU
task_memory     = 1024     # 1 GB RAM
desired_count   = 1

# RDS PostgreSQL
db_instance_class    = "db.t3.micro"   # Free tier eligible
db_allocated_storage = 20
db_name              = "litellm"
db_username          = "litellm"

# Cloudflare (optional — for custom domain)
# domain        = "yourdomain.com"
# subdomain     = "litellm"
# acm_certificate_arn = ""  # Leave empty if using Cloudflare SSL proxy
