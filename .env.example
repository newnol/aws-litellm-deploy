# =============================================================================
# LiteLLM Proxy - Environment Variables
# =============================================================================
# Copy this file to .env and fill in your values.
# Usage: cp .env.example .env && vi .env
# =============================================================================

# PostgreSQL / Aurora dSQL connection string
DATABASE_URL=

# LiteLLM master key for authentication
LITELLM_MASTER_KEY=sk-litellm-master

# OpenAI API key (used by LiteLLM to call OpenAI models)
OPENAI_API_KEY=
